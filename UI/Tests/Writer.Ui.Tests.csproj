<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Writer.Ui.csproj" />
    <ProjectReference Include="../../Core/Writer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Tests/Support/EcsSystemTest.cs" Link="Support/EcsSystemTest.cs" />
    <Compile Include="../../Tests/Support/Fakes/FakeVisualRidFactory.cs" Link="Support/FakeVisualRidFactory.cs" />
  </ItemGroup>
</Project>
