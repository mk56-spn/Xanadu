<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The generic Xanadu.Ui feature demo on MoonWorks (docs/host.md §5.9):
    a plain exe on HostCore that needs only the UI and Core assemblies.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Xanadu.Ui.Showcase</AssemblyName>
    <RootNamespace>Xanadu.Ui.Showcase</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../HostCore/Xanadu.HostCore.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
  <Import Project="../../Core/Maths/Maths.props" />
</Project>
