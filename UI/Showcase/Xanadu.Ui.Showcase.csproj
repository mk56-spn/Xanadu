<Project Sdk="Godot.NET.Sdk/4.8.0-dev.7">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GodotProjectDir>$(MSBuildProjectDirectory)/</GodotProjectDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/Xanadu.Core.csproj" />
    <ProjectReference Include="../Xanadu.Ui.csproj" />
  </ItemGroup>
  <Target Name="CanonicalizeGodotProjectDir" BeforeTargets="GenerateMSBuildEditorConfigFileCore"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Exec Command="realpath &quot;$(MSBuildProjectDirectory)&quot;"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CanonicalGodotProjectDir" />
    </Exec>
    <PropertyGroup>
      <_CanonicalGodotProjectDir>@(_CanonicalGodotProjectDir)</_CanonicalGodotProjectDir>
      <GodotProjectDir Condition=" '$(_CanonicalGodotProjectDir)' != '' ">$(_CanonicalGodotProjectDir)/</GodotProjectDir>
      <GodotProjectDirBase64></GodotProjectDirBase64>
    </PropertyGroup>
  </Target>
</Project>
