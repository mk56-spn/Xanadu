<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The XAF animator on MoonWorks (Docs/host.md §5.9): a plain exe on
    HostCore. Relative paths are under the game folder, as in every host exe; the
    animator's own rigs and art live under Tools/Animator (AnimatorPaths).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xanadu.AnimatorTool</AssemblyName>
    <RootNamespace>Xanadu.Tools.Animator</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../HostCore/Xanadu.HostCore.csproj" />
    <ProjectReference Include="../../Game/Xanadu.csproj" />
    <ProjectReference Include="../../Core/Xanadu.Core.csproj" />
    <ProjectReference Include="../../UI/Xanadu.Ui.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
  <Import Project="../../Core/Maths/Maths.props" />
</Project>
