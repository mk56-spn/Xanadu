; Engine configuration file for the standalone Xanadu lab.
config_version=5

[application]

config/name="Xanadu Lab"
run/main_scene="res://Lab.tscn"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")

[dotnet]

project/assembly_name="Xanadu.Lab"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"

[shader_globals]

lab_mouse={
"type": "vec2",
"value": Vector2(0, 0)
}
