<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike: the simplest GPU particles on MoonWorks (SDL_GPU, Vulkan). Plain .NET, no Godot. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../External/MoonWorks/MoonWorks.csproj" />
    <PackageReference Include="Slangc.NET" Version="2026.21.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Shaders/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
