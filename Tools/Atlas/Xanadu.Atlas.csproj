<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Atlas: a map of the project's types, read from the built assemblies'
    metadata (Tools/Atlas/CodeMap.cs), to click through what touches what:
    which systems query which components, who implements and inherits what,
    and which types use which. Built like Autopsy: its own exe on HostCore.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xanadu.Atlas</AssemblyName>
    <RootNamespace>Xanadu.Tools.Atlas</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../HostCore/Xanadu.HostCore.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
  <Import Project="../../Core/Maths/Maths.props" />
</Project>
