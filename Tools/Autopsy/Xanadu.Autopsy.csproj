<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Autopsy of a frame: opens the frame captures every host exe saves when it
    closes (HostCore/Autopsy) and splits one frame's CPU and GPU time into bars.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xanadu.Autopsy</AssemblyName>
    <RootNamespace>Xanadu.Tools.Autopsy</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <ProjectReference Include="../../HostCore/Xanadu.HostCore.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
  <Import Project="../../Core/Maths/Maths.props" />
</Project>
