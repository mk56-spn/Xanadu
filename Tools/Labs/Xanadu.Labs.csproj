<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Xanadu Labs on MoonWorks (docs/moonworks-port.md): a sandbox of isolated
    experiments, one tab each. A plain exe on HostCore; it needs the UI and Core
    assemblies, never the game's. The Godot lab in Tools/Lab stays as reference
    until its experiments are rebuilt here one at a time.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xanadu.Labs</AssemblyName>
    <RootNamespace>Xanadu.Labs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../HostCore/Xanadu.HostCore.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Shaders/*" CopyToOutputDirectory="PreserveNewest" LinkBase="Shaders" />
  </ItemGroup>
  <Import Project="../../Core/Maths/Maths.props" />
</Project>
