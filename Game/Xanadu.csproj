<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The game's exe is its own project. -->
    <Compile Remove="Host/**/*.cs" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
    <PackageReference Include="Friflo.Engine.ECS.Boost" Version="4.0.0-preview.2" />
    <PackageReference Include="Miniaudio-CS" Version="1.0.4" />
    <PackageReference Include="Box2DSharp" Version="0.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Xanadu.Core.csproj" />
    <ProjectReference Include="../UI/Xanadu.Ui.csproj" />
    <Content Include="../agents.md" Link="agents.md" />
    <InternalsVisibleTo Include="Xanadu.Tests" />
  </ItemGroup>
  <Import Project="../Core/Maths/Maths.props" />
</Project>
