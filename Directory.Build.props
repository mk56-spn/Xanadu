<Project>
  <!--
    Only the UI library reads the pointer and the wheel (BannedSymbols.txt),
    and only Storage touches disk (BannedSymbols.Io.txt).
    Every other project of ours gets the banned-API analyzer with RS0030 as an
    error; UI, its showcase, the tests and External are left alone.
  -->
  <!-- The .editorconfig code-style rules (IDE*) are reported by dotnet build too, not only in an editor; External keeps its own style. -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('External'))">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup>
    <XanaduBansPointer Condition="'$(XanaduBansPointer)' == ''">false</XanaduBansPointer>
    <XanaduBansPointer Condition="'$(MSBuildProjectName)' == 'Xanadu' Or '$(MSBuildProjectName)' == 'Xanadu.Host' Or '$(MSBuildProjectName)' == 'Xanadu.HostCore' Or '$(MSBuildProjectName)' == 'Xanadu.Rendering' Or '$(MSBuildProjectName)' == 'Xanadu.AnimatorTool' Or '$(MSBuildProjectName)' == 'Xanadu.Labs' Or '$(MSBuildProjectName)' == 'Xanadu.DevTools' Or '$(MSBuildProjectName)' == 'Xanadu.Core' Or '$(MSBuildProjectName)' == 'Xanadu.Model' Or '$(MSBuildProjectName)' == 'Xanadu.Logic' Or '$(MSBuildProjectName)' == 'Xanadu.Screens' Or '$(MSBuildProjectName)' == 'Xanadu.Slang'">true</XanaduBansPointer>
    <!-- Only Storage touches disk (BannedSymbols.Io.txt); the host, tools, Slang, UI and the audio core keep their own files. -->
    <XanaduBansIo Condition="'$(XanaduBansIo)' == ''">false</XanaduBansIo>
    <XanaduBansIo Condition="'$(MSBuildProjectName)' == 'Xanadu' Or '$(MSBuildProjectName)' == 'Xanadu.Core' Or '$(MSBuildProjectName)' == 'Xanadu.Model' Or '$(MSBuildProjectName)' == 'Xanadu.Serialisation' Or '$(MSBuildProjectName)' == 'Xanadu.Drawers' Or '$(MSBuildProjectName)' == 'Xanadu.Logic' Or '$(MSBuildProjectName)' == 'Xanadu.Screens'">true</XanaduBansIo>
  </PropertyGroup>
  <ItemGroup Condition="'$(XanaduBansPointer)' == 'true' Or '$(XanaduBansIo)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all"/>
  </ItemGroup>
  <ItemGroup Condition="'$(XanaduBansPointer)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt"/>
  </ItemGroup>
  <ItemGroup Condition="'$(XanaduBansIo)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Io.txt"/>
  </ItemGroup>
  <PropertyGroup Condition="'$(XanaduBansPointer)' == 'true' Or '$(XanaduBansIo)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>
</Project>
