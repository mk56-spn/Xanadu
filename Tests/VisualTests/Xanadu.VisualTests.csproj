<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The scene-test browser on MoonWorks (Docs/host.md §5.9): a plain exe
    on HostCore that boots the game's ECS world beside an ECS sidebar. Relative paths are
    under the game folder; user:// is its own xanadu-visual-tests folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xanadu.VisualTests</AssemblyName>
    <RootNamespace>Xanadu.Tests.VisualTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="NUnitIntegrationTests.cs" />
    <Compile Remove="SceneTestRunnerTests.cs" />
    <ProjectReference Include="../../HostCore/Xanadu.HostCore.csproj" />
    <ProjectReference Include="../../Game/Host/Xanadu.Host.csproj" />
    <ProjectReference Include="../../Game/Xanadu.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
  <Import Project="../../Core/Maths/Maths.props" />
</Project>
