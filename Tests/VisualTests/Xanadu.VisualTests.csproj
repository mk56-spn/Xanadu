<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The scene-test browser on MoonWorks (docs/moonworks-port.md step 10): a plain exe
    on HostCore that boots the game's ECS world beside an ECS sidebar. res:// is the
    game folder; user:// is its own "Xanadu Visual Tests" folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xanadu.VisualTests</AssemblyName>
    <RootNamespace>Xanadu.Tests.VisualTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="NUnitIntegrationTests.cs" />
    <Compile Remove="SceneTestRunnerTests.cs" />
    <ProjectReference Include="../../HostCore/Xanadu.HostCore.csproj" />
    <ProjectReference Include="../../Host/Xanadu.Host.csproj" />
    <ProjectReference Include="../../Xanadu.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
  <Import Project="../../Core/Maths/Maths.props" />
</Project>
