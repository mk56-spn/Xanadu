<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="VisualTests/Harness/**/*.cs" />
    <Compile Remove="VisualTests/Cases/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Writer.csproj" />
    <ProjectReference Include="../Core/Writer.Core.csproj" />
    <ProjectReference Include="../UI/Writer.Ui.csproj" />
    <ProjectReference Include="VisualTests/Writer.VisualTests.csproj" />
  </ItemGroup>
</Project>
