# Godot 4+ specific ignores
.godot/
/android/

# C# / .NET build output
bin/
obj/

# IDE / user-specific files
.idea/
.vs/
.vscode/
*.user
*.suo
*.userprefs

# OS files
.DS_Store
Thumbs.db

# Screenshots are never committed or pushed: local scratch only
.shots/
screenshots/

# Agent scratch (screenshots, dotnet temp, tool configs)
.tmp/

# Agent workspaces (worktrees, local settings)
.claude/

# Music lives in user://songs, never in the repo
*.mp3
*.ogg
*.flac

# MoonWorks native libraries: fetched by External/fetch-moonlibs.sh
External/moonlibs/
