<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The game on MoonWorks (docs/moonworks-port.md). A plain .NET exe on HostCore: it
    references the game assemblies the same way the tests do and never starts Godot.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xanadu.Host</AssemblyName>
    <RootNamespace>Xanadu.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HostCore/Xanadu.HostCore.csproj" />
    <ProjectReference Include="../Xanadu.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
</Project>
