<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Slang layer's tests: no game, no host. Core and UI are fair game if a test ever needs them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Xanadu.Slang.csproj" />
  </ItemGroup>
  <Import Project="../../Core/Maths/Maths.props" />
</Project>
