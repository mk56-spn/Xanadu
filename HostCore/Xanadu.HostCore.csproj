<Project Sdk="Microsoft.NET.Sdk">
  <!--
    What every MoonWorks exe shares (Docs/host.md): the window and frame
    loop (HostApp), input, native dialogs, the frame autopsy and the tool
    shell, drawing through Rendering. The game (Host) and the tools (Tools/Labs, …) build on it.
    It knows the UI and Core assemblies, never the game's.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xanadu.HostCore</AssemblyName>
    <RootNamespace>Xanadu.Host</RootNamespace>
    <!-- Lets an exe's RuntimeIdentifier (-r win-x64) reach this project, so it picks that platform's native libraries. -->
    <IsRidAgnostic>false</IsRidAgnostic>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xanadu.Host" />
    <InternalsVisibleTo Include="Xanadu.Labs" />
    <InternalsVisibleTo Include="Xanadu.AnimatorTool" />
    <InternalsVisibleTo Include="Xanadu.DevTools" />
    <InternalsVisibleTo Include="Xanadu.ShaderTool" />
    <InternalsVisibleTo Include="Xanadu.Ui.Showcase" />
    <InternalsVisibleTo Include="Xanadu.VisualTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <ProjectReference Include="../External/MoonWorks/MoonWorks.csproj" />
    <ProjectReference Include="../Core/Xanadu.Core.csproj" />
    <ProjectReference Include="../Slang/Xanadu.Slang.csproj" />
    <ProjectReference Include="../UI/Xanadu.Ui.csproj" />
    <ProjectReference Include="../Rendering/Xanadu.Rendering.csproj" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
  <!--
    Native libraries from External/fetch-moonlibs.sh (or .ps1), copied next to every exe that
    references this. The set follows the platform being built for: the RuntimeIdentifier when
    one is given (dotnet build -r win-x64 from Linux works), else the machine building.
  -->
  <PropertyGroup>
    <MoonlibsPlatform Condition="$(RuntimeIdentifier.StartsWith('win'))">win64</MoonlibsPlatform>
    <MoonlibsPlatform Condition="$(RuntimeIdentifier.StartsWith('linux'))">lib64</MoonlibsPlatform>
    <MoonlibsPlatform Condition="'$(MoonlibsPlatform)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win64</MoonlibsPlatform>
    <MoonlibsPlatform Condition="'$(MoonlibsPlatform)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">lib64</MoonlibsPlatform>
    <MoonlibsCheckFile Condition="'$(MoonlibsPlatform)' == 'win64'">SDL3.dll</MoonlibsCheckFile>
    <MoonlibsCheckFile Condition="'$(MoonlibsPlatform)' == 'lib64'">libSDL3.so.0</MoonlibsCheckFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(MoonlibsPlatform)' != ''">
    <None Include="../External/moonlibs/$(MoonlibsPlatform)/*" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="CheckMoonlibs" BeforeTargets="Build" Condition="'$(MoonlibsPlatform)' != '' And !Exists('../External/moonlibs/$(MoonlibsPlatform)/$(MoonlibsCheckFile)')">
    <Error Text="MoonWorks native libraries for $(MoonlibsPlatform) are missing: run External/fetch-moonlibs.sh (Linux) or External/fetch-moonlibs.ps1 (Windows)" />
  </Target>
  <!--
    The GPU timing layer (Native/gpu_times_layer.c, read by Rendering/GpuTimes.cs): built with gcc against
    External/fetch-vulkan-headers.sh's headers and copied next to every exe with its manifest.
    Without the headers it is skipped and XANADU_GPU_TIMES=1 says so.
  -->
  <PropertyGroup>
    <GpuTimesLayer>$(MSBuildThisFileDirectory)obj/native/libxanadu_gpu_times.so</GpuTimesLayer>
    <BuildGpuTimes Condition="'$(MoonlibsPlatform)' == 'lib64' And Exists('../External/vulkan-headers/include/vulkan/vk_layer.h')">true</BuildGpuTimes>
  </PropertyGroup>
  <Target Name="BuildGpuTimesLayer" BeforeTargets="AssignTargetPaths" Condition="'$(BuildGpuTimes)' == 'true'" Inputs="Native/gpu_times_layer.c" Outputs="$(GpuTimesLayer)">
    <MakeDir Directories="$(MSBuildThisFileDirectory)obj/native" />
    <Exec Command="gcc -shared -fPIC -O2 -Wall -fvisibility=hidden -I../External/vulkan-headers/include Native/gpu_times_layer.c -o &quot;$(GpuTimesLayer)&quot; -lpthread" />
  </Target>
  <Target Name="AddGpuTimesLayer" AfterTargets="BuildGpuTimesLayer" BeforeTargets="AssignTargetPaths" Condition="'$(BuildGpuTimes)' == 'true'">
    <ItemGroup>
      <None Include="$(GpuTimesLayer)" Link="libxanadu_gpu_times.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="Native/xanadu_gpu_times.json" Link="xanadu_gpu_times.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
  <Import Project="../Core/Maths/Maths.props" />
</Project>
