<Project Sdk="Microsoft.NET.Sdk">
  <!--
    What every MoonWorks exe shares (Docs/host.md): the window and frame
    loop (HostApp), the canvas tree and renderer, text, input and
    native dialogs. The game (Host) and the tools (Tools/Labs, …) build on it.
    It knows the UI and Core assemblies, never the game's.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Xanadu.HostCore</AssemblyName>
    <RootNamespace>Xanadu.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xanadu.Host" />
    <InternalsVisibleTo Include="Xanadu.Labs" />
    <InternalsVisibleTo Include="Xanadu.AnimatorTool" />
    <InternalsVisibleTo Include="Xanadu.DevTools" />
    <InternalsVisibleTo Include="Xanadu.ShaderTool" />
    <InternalsVisibleTo Include="Xanadu.Ui.Showcase" />
    <InternalsVisibleTo Include="Xanadu.VisualTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <ProjectReference Include="../External/MoonWorks/MoonWorks.csproj" />
    <ProjectReference Include="../Core/Xanadu.Core.csproj" />
    <ProjectReference Include="../Slang/Xanadu.Slang.csproj" />
    <ProjectReference Include="../UI/Xanadu.Ui.csproj" />
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
    <PackageReference Include="HarfBuzzSharp" Version="14.4.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Shaders/*" CopyToOutputDirectory="PreserveNewest" LinkBase="Shaders" />
  </ItemGroup>
  <!-- Native libraries from External/fetch-moonlibs.sh, copied next to every exe that references this. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="../External/moonlibs/lib64/*" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="CheckMoonlibs" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux')) And !Exists('../External/moonlibs/lib64/libSDL3.so.0')">
    <Error Text="MoonWorks native libraries are missing: run External/fetch-moonlibs.sh" />
  </Target>
  <!--
    The GPU timing layer (Native/gpu_times_layer.c, Rendering/GpuTimes.cs): built with gcc against
    External/fetch-vulkan-headers.sh's headers and copied next to every exe with its manifest.
    Without the headers it is skipped and XANADU_GPU_TIMES=1 says so.
  -->
  <PropertyGroup>
    <GpuTimesLayer>$(MSBuildThisFileDirectory)obj/native/libxanadu_gpu_times.so</GpuTimesLayer>
    <BuildGpuTimes Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('../External/vulkan-headers/include/vulkan/vk_layer.h')">true</BuildGpuTimes>
  </PropertyGroup>
  <Target Name="BuildGpuTimesLayer" BeforeTargets="AssignTargetPaths" Condition="'$(BuildGpuTimes)' == 'true'" Inputs="Native/gpu_times_layer.c" Outputs="$(GpuTimesLayer)">
    <MakeDir Directories="$(MSBuildThisFileDirectory)obj/native" />
    <Exec Command="gcc -shared -fPIC -O2 -Wall -fvisibility=hidden -I../External/vulkan-headers/include Native/gpu_times_layer.c -o &quot;$(GpuTimesLayer)&quot; -lpthread" />
  </Target>
  <Target Name="AddGpuTimesLayer" AfterTargets="BuildGpuTimesLayer" BeforeTargets="AssignTargetPaths" Condition="'$(BuildGpuTimes)' == 'true'">
    <ItemGroup>
      <None Include="$(GpuTimesLayer)" Link="libxanadu_gpu_times.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="Native/xanadu_gpu_times.json" Link="xanadu_gpu_times.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
  <Import Project="../Core/Maths/Maths.props" />
</Project>
