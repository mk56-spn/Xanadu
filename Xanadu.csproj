<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Core/**/*.cs" />
    <Compile Remove="UI/**/*.cs" />
    <Compile Remove="Tools/**/*.cs" />
    <Compile Remove="External/**/*.cs" />
    <Compile Remove="Host/**/*.cs" />
    <Compile Remove="HostCore/**/*.cs" />
    <!-- Godot's math structs only (P8): no engine runs. -->
    <PackageReference Include="GodotSharp" Version="4.8.0-dev.7" />
    <PackageReference Include="Friflo.Engine.ECS" Version="4.0.0-preview.2" />
    <PackageReference Include="Friflo.Engine.ECS.Boost" Version="4.0.0-preview.2" />
    <PackageReference Include="Miniaudio-CS" Version="1.0.4" />
    <PackageReference Include="Box2DSharp" Version="0.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Core/Xanadu.Core.csproj" />
    <ProjectReference Include="UI/Xanadu.Ui.csproj" />
    <Content Include="agents.md" />
    <InternalsVisibleTo Include="Xanadu.Tests" />
  </ItemGroup>
</Project>
